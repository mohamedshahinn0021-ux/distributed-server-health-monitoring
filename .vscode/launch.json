{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Start Backend Server (Express + Socket.IO)",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/server/index.js",
      "cwd": "${workspaceFolder}/server",
      "env": {
        "NODE_ENV": "development",
        "PORT": "5000"
      }
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Run FSM & Security Unit Tests",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/server/test-fsm.js",
      "cwd": "${workspaceFolder}/server"
    }
  ]
}
