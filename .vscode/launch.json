{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "🚀 Start Distributed Server Monitor",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/server.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "NODE_ENV": "development",
        "PORT": "5000"
      }
    },
    {
      "type": "node",
      "request": "launch",
      "name": "🧪 Run System Verification Test Suite",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/test-system.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
